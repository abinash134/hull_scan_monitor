# Copy this file to .env and fill in your values, or export them in your shell.

# The chartink screener URL to monitor
HULL_SCAN_URL=https://chartink.com/screener/hull-scan-28

# How often to scan (in minutes)
HULL_SCAN_INTERVAL=5

# Market hours (IST) during which the scanner runs. Outside these hours
# (and on Sat/Sun) the script stays idle but keeps running.
MARKET_TZ=Asia/Kolkata
MARKET_OPEN=09:30
MARKET_CLOSE=15:30

# SQLite database file (optional; defaults to scan_history.db next to scanner.py)
# HULL_SCAN_DB=/path/to/scan_history.db

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Your Telegram chat id (get it from @userinfobot)
TELEGRAM_CHAT_ID=
