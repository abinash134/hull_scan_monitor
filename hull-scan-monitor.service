[Unit]
Description=HULL Scan Monitor (Chartink -> SQLite -> Telegram)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/hull_scan_monitor
ExecStart=/opt/hull_scan_monitor/venv/bin/python3 /opt/hull_scan_monitor/scanner.py
Restart=always
RestartSec=30
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
